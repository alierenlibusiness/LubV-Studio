# Normalise line endings so the repository stays consistent across platforms.
* text=auto eol=lf

# Windows launchers must keep CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf

# Shell scripts must keep LF or the shebang breaks.
*.sh text eol=lf

# Never touch binaries.
*.ico binary
*.png binary
*.icns binary
*.exe binary
